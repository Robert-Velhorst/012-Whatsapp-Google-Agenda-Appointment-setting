# Runtime. APP_ENV=production enables strict startup validation.
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:5000
WORKSPACE_ID=default
WORKSPACE_NAME=My scheduling desk
OPERATOR_NAME=Operator

# Required to receive WhatsApp Cloud API webhooks.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_REMINDER_TEMPLATE=

# Required for browser-based Google OAuth. Put the downloaded web client JSON outside this repository.
GOOGLE_CLIENT_SECRETS_FILE=C:/secure/google-client-secret.json
GOOGLE_TOKEN_FILE=./data/google-token.json
GOOGLE_CALENDAR_ID=primary
TIMEZONE=Europe/Amsterdam

# Application security / behaviour
FLASK_SECRET_KEY=replace-with-a-long-random-value
ADMIN_API_TOKEN=replace-with-a-long-random-value
ADMIN_PASSWORD_HASH=
DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/scheduler.sqlite3
AUTO_SEND_SUGGESTIONS=false
AUTO_BOOK_CONFIRMED=false
AUTOMATION_PAUSED=false
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
SLOT_INTERVAL_MINUTES=30
DEFAULT_DURATION_MINUTES=30
REMINDER_MINUTES_BEFORE=1440
DATA_RETENTION_DAYS=30
BOOKING_LINK_TTL_HOURS=168
MAX_OUTBOUND_PER_CONTACT_PER_HOUR=10

# Optional read-only, metadata-minimized HAI JSON feed. Keep it local/owner-scoped.
HAI_CONNECTOR_ENABLED=false
HAI_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
HAI_FEED_PAGE_SIZE=100
HAI_PROJECT_KEY=012-Whatsapp-Google-Agenda-Appointment-setting

# Public ingress. Start-Ngrok.ps1 refuses to expose a non-production/non-ready app.
NGROK_DOMAIN=
NGROK_CONFIG_FILE=
NGROK_INSPECTOR_PORT=4042
PORT=5000
WORKER_INTERVAL_SECONDS=30
WAITRESS_THREADS=4
WAITRESS_CONNECTION_LIMIT=100
